# =============================================================================
# Bahikhata — environment
# Copy to `.env` at the repo root. Both apps load from this single file.
# Validated on boot by packages/shared/src/env.ts — a missing or malformed
# value crashes the process at startup, never mid-request.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database (Neon PostgreSQL) --------------------------------------------
# Use the POOLED connection string (host contains "-pooler") for the app.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/bahikhata?sslmode=require

# Direct (non-pooled) connection. Used by drizzle-kit for migrations only.
# Leave blank to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Auth (NextAuth / Auth.js) ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness
AUTH_URL=http://localhost:3000

# --- App -------------------------------------------------------------------
# Public origin. Used for catalog QR codes and absolute OG/canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Storage ------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=invoices

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Escape hatch ----------------------------------------------------------
# Set to "true" to skip env validation (CI builds, Docker image builds).
# Never set this in a running production server.
SKIP_ENV_VALIDATION=
